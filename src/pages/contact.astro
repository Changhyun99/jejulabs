---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="제주랩스에 문의하세요.">

  <div class="contact-wrap">

    <header class="contact-header">
      <p class="contact-eyebrow">JEJULABS</p>
      <h1>Contact</h1>
    </header>

    <div class="contact-grid">

      <div class="contact-row">
        <span class="contact-label">Email</span>
        <div class="contact-value">
          <a href="mailto:contact@jejulabs.com" class="contact-email">
            contact@jejulabs.com
          </a>
        </div>
      </div>

      <div class="contact-divider"></div>

      <div class="contact-row">
        <span class="contact-label">본점</span>
        <div class="contact-value">
          <p>서귀포시 중정로 86</p>
          <p class="contact-sub">서귀포스타트업베이 3층 302-A호</p>
        </div>
      </div>

      <div class="contact-divider"></div>

      <div class="contact-row">
        <span class="contact-label">제조소</span>
        <div class="contact-value">
          <p>제주시 서광로 237, 2층</p>
        </div>
      </div>

      <div class="contact-divider"></div>

    </div>

  </div>

</BaseLayout>

<style>
  .contact-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 100px) var(--jl-space-lg) clamp(80px, 12vw, 140px);
  }

  .contact-header {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .contact-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--jl-terra);
    margin-bottom: 16px;
  }

  .contact-header h1 {
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--jl-text-primary);
    line-height: 1;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
  }

  .contact-divider {
    height: 1px;
    background: rgba(26, 58, 42, 0.12);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--jl-space-lg);
    align-items: baseline;
    padding: 28px 0;
  }

  .contact-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--jl-text-muted);
    padding-top: 4px;
  }

  .contact-value p {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--jl-text-primary);
    line-height: 1.6;
    margin: 0;
    word-break: keep-all;
  }

  .contact-sub {
    color: var(--jl-text-secondary) !important;
    font-size: 0.9rem !important;
    font-weight: 400 !important;
    margin-top: 4px !important;
  }

  .contact-email {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--jl-text-primary);
    text-decoration: none;
    transition: color var(--jl-transition);
    position: relative;
  }

  .contact-email::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--jl-terra);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .contact-email:hover {
    color: var(--jl-terra);
  }

  .contact-email:hover::after {
    transform: scaleX(1);
  }

  @media (max-width: 767px) {
    .contact-wrap {
      padding: 48px var(--jl-space-md) 80px;
    }

    .contact-row {
      grid-template-columns: 72px 1fr;
      gap: var(--jl-space-md);
      padding: 22px 0;
    }
  }
</style>
