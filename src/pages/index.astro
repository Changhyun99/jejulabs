---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryNames: Record<string, string> = {
  'people': '사람',
  'object': '사물',
  'culture': '문화',
  'reinterpret': '재해석',
  'notice': '공지',
};

// 카테고리별 설명 문구
const categoryDescriptions: Record<string, string> = {
  'object': '우리가 매일 스치는 물건들에는 이유가 있다. 모양에도, 향에도, 질감에도. 그 이유를 들여다보는 일은, 세상을 다시 보는 일이다.',
  'people': '어떤 사람이 그 자리에 있는 데는 이유가 있다. 우리는 무엇을 하는지가 아니라, 왜 그것을 하는지를 묻는다.',
  'culture': '오래 남은 것에는 오래 남은 이유가 있다. 사라져가는 것에도 사라지는 이유가 있다. 우리는 그 결을 읽는다.',
  'reinterpret': '발견은 시작이지 끝이 아니다. 우리가 본 것들을, 다음의 무언가로 옮긴다.',
};

// 메인 섹션에 노출할 카테고리 순서: 사람 → 사물 → 문화 → 재해석
const sectionOrder = ['people', 'object', 'culture', 'reinterpret'];

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
}

const heroPost = posts[0];

// 카테고리별로 글 묶기 (히어로로 쓰인 글도 카테고리 줄에는 그대로 포함)
const sections = sectionOrder.map(cat => ({
  key: cat,
  name: categoryNames[cat] || cat,
  description: categoryDescriptions[cat] || '',
  posts: posts.filter(p => p.data.category === cat).slice(0, 4),
})).filter(section => section.posts.length > 0);
---

<BaseLayout title="Home">
  <div class="main-content">

    {/* ★ ZONE 1 — 히어로: 최신 글 1개, 그대로 유지 */}
    {heroPost && (
      <a href={`/blog/${heroPost.id}`} class="home-hero">
        <div class="home-hero-image">
          {heroPost.data.thumbnail ? (
            <img src={heroPost.data.thumbnail} alt={heroPost.data.title} />
          ) : (
            <div class="home-hero-placeholder"></div>
          )}
        </div>
        <div class="home-hero-info">
          <span class="home-hero-category">
            {categoryNames[heroPost.data.category] || heroPost.data.category}
          </span>
          <h1 class="home-hero-title">{heroPost.data.title}</h1>
          <p class="home-hero-desc">{heroPost.data.description}</p>
          <div class="home-hero-meta">
            <span class="home-hero-author">{heroPost.data.author}</span>
            <time>{formatDate(heroPost.data.date)}</time>
          </div>
        </div>
      </a>
    )}

    {/* ★ ZONE 2 — 카테고리별 가로 한 줄 나열 */}
    {sections.map(section => (
      <section class="home-row-section">
        <div class="home-row-head">
          <h2 class="home-row-title">{section.name}</h2>
          <a href={`/category/${section.key}`} class="home-row-more">전체 보기 →</a>
          {section.description && (
            <p class="home-row-desc">{section.description}</p>
          )}
        </div>
        <div class="home-row">
          {section.posts.map(post => (
            <a href={`/blog/${post.id}`} class="home-row-card">
              <div class="home-row-card-image">
                {post.data.thumbnail ? (
                  <img src={post.data.thumbnail} alt={post.data.title} />
                ) : (
                  <div class="home-row-card-placeholder"></div>
                )}
              </div>
              <h3 class="home-row-card-title">{post.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    ))}

    {/* ★ ZONE 3 — 뉴스레터 (그대로 유지) */}
    <div class="newsletter-cta">
      <h2 class="newsletter-cta-title">제주에서 시작되는 이야기,<br/>놓치지 않으려면.</h2>
      <p class="newsletter-cta-desc">이메일을 남겨주세요.<br/>제주랩스의 새로운 이야기가 찾아갑니다.</p>
      <form
        class="newsletter-cta-form"
        name="newsletter"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <input type="hidden" name="bot-field" />
        <input type="email" name="email" placeholder="이메일 주소를 입력하세요" required />
        <button type="submit">구독하기</button>
      </form>
    </div>

  </div>
</BaseLayout>
