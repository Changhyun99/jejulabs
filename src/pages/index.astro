---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryNames: Record<string, string> = {
  'people': 'People',
  'discovery': 'Discovery',
  'making': 'Making',
  'jeju': 'Jeju',
  'notice': 'Notice',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\./g, '.').replace(/\s/g, ' ');
}

const heroPost = posts[0];
const gridPosts = posts.slice(1, 7);
const hasMore = posts.length > 7;
---

<BaseLayout title="Home">
  <div class="main-content">

    {/* ★ ZONE 1 — 히어로: 최신 글 1개, 스플릿 레이아웃 */}
    {heroPost && (
      <a href={`/blog/${heroPost.id}`} class="home-hero">
        <div class="home-hero-image">
          {heroPost.data.thumbnail ? (
            <img src={heroPost.data.thumbnail} alt={heroPost.data.title} />
          ) : (
            <div class="home-hero-placeholder"></div>
          )}
        </div>
        <div class="home-hero-info">
          <span class="home-hero-category">
            {categoryNames[heroPost.data.category] || heroPost.data.category}
          </span>
          <h1 class="home-hero-title">{heroPost.data.title}</h1>
          <p class="home-hero-desc">{heroPost.data.description}</p>
          <div class="home-hero-meta">
            <span class="home-hero-author">{heroPost.data.author}</span>
            <time>{formatDate(heroPost.data.date)}</time>
          </div>
        </div>
      </a>
    )}

    {/* ★ ZONE 2 — 카드 그리드: 2열, 최대 6개 */}
    {gridPosts.length > 0 && (
      <section class="home-grid-section">
        <div class="home-grid">
          {gridPosts.map(post => (
            <a href={`/blog/${post.id}`} class="home-card">
              <div class="home-card-image">
                {post.data.thumbnail ? (
                  <img src={post.data.thumbnail} alt={post.data.title} />
                ) : (
                  <div class="home-card-placeholder"></div>
                )}
              </div>
              <div class="home-card-body">
                <span class="home-card-category">
                  {categoryNames[post.data.category] || post.data.category}
                </span>
                <h2 class="home-card-title">{post.data.title}</h2>
                <p class="home-card-desc">{post.data.description}</p>
                <div class="home-card-meta">
                  <span class="home-card-author">{post.data.author}</span>
                  <time>{formatDate(post.data.date)}</time>
                </div>
              </div>
            </a>
          ))}
        </div>
        {hasMore && (
          <div class="home-grid-more">
            <a href="/blog" class="home-grid-more-btn">더 많은 이야기 →</a>
          </div>
        )}
      </section>
    )}

    {/* ★ ZONE 3 — 뉴스레터 */}
    <div class="newsletter-cta">
      <h2 class="newsletter-cta-title">제주에서 시작되는 이야기,<br/>놓치지 않으려면.</h2>
      <p class="newsletter-cta-desc">이메일을 남겨주세요.<br/>제주랩스의 새로운 이야기가 찾아갑니다.</p>
      <form
        class="newsletter-cta-form"
        name="newsletter"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <input type="hidden" name="bot-field" />
        <input type="email" name="email" placeholder="이메일 주소를 입력하세요" required />
        <button type="submit">구독하기</button>
      </form>
    </div>

  </div>
</BaseLayout>
