---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryNames: Record<string, string> = {
  'people': 'People',
  'discovery': 'Discovery',
  'making': 'Making',
  'jeju': 'Jeju',
  'notice': 'Notice',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---

<BaseLayout title="Home">

  <div class="post-grid">
    {posts.map((post, index) => {
      const pos = index % 6;
      return (
        <article class={`grid-post pos-${pos}`}>
          <a href={`/blog/${post.id}`}>
            {post.data.thumbnail
              ? <img src={post.data.thumbnail} alt={post.data.title} class="grid-post-img" />
              : <div class="grid-post-placeholder"></div>
            }
            <div class="grid-post-overlay">
              <span class="grid-post-category">
                {categoryNames[post.data.category] || post.data.category}
              </span>
              <h2 class="grid-post-title">{post.data.title}</h2>
              <p class="grid-post-desc">{post.data.description}</p>
              <div class="grid-post-meta">
                <span class="grid-post-author">{post.data.author}</span>
                <time>{formatDate(post.data.date)}</time>
              </div>
            </div>
          </a>
        </article>
      );
    })}
  </div>

  <div class="newsletter-cta">
    <h2 class="newsletter-cta-title">제주에서 시작되는 이야기,<br>놓치지 않으려면.</h2>
    <p class="newsletter-cta-desc">이메일을 남겨주세요.<br>제주랩스의 새로운 이야기가 찾아갑니다.</p>
    <form
      class="newsletter-cta-form"
      name="newsletter"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="newsletter" />
      <input type="hidden" name="bot-field" />
      <input type="email" name="email" placeholder="이메일 주소를 입력하세요" required />
      <button type="submit">구독하기</button>
    </form>
  </div>

</BaseLayout>
