---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryNames: Record<string, string> = {
  'people': 'People',
  'discovery': 'Discovery',
  'making': 'Making',
  'jeju': 'Jeju',
  'notice': 'Notice',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\./g, '.').replace(/\s/g, ' ');
}

// 3개씩 묶어서 블록 단위로 분리
const blocks: typeof posts[] = [];
for (let i = 0; i < posts.length; i += 3) {
  blocks.push(posts.slice(i, i + 3));
}
---

<BaseLayout title="Home">
  <div class="main-content">
    <div class="editorial-grid">
      {blocks.map((block, blockIndex) => {
        const isEven = blockIndex % 2 === 0;
        // even 블록: 왼쪽 tall (0=tall, 1=short-top, 2=short-bottom)
        // odd 블록: 오른쪽 tall (0=short-top, 1=short-bottom, 2=tall)
        return (
          <div class={`editorial-block ${isEven ? 'tall-left' : 'tall-right'}`}>
            {block.map((post, i) => {
              let posClass = '';
              if (isEven) {
                posClass = i === 0 ? 'cell-tall' : i === 1 ? 'cell-short-top' : 'cell-short-bottom';
              } else {
                posClass = i === 0 ? 'cell-short-top' : i === 1 ? 'cell-short-bottom' : 'cell-tall';
              }
              return (
                <article class={`grid-post ${posClass}`}>
                  <a href={`/blog/${post.id}`}>
                    {post.data.thumbnail ? (
                      <img class="grid-post-img" src={post.data.thumbnail} alt={post.data.title} />
                    ) : (
                      <div class="grid-post-placeholder" />
                    )}
                    <div class="grid-post-overlay">
                      <span class="grid-post-category">
                        {categoryNames[post.data.category] || post.data.category}
                      </span>
                      <h2 class="grid-post-title">{post.data.title}</h2>
                      <p class="grid-post-desc">{post.data.description}</p>
                      <div class="grid-post-meta">
                        <span class="grid-post-author">{post.data.author}</span>
                        <time>{formatDate(post.data.date)}</time>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        );
      })}
    </div>

    {/* NEWSLETTER CTA */}
    <div class="newsletter-cta">
      <h2 class="newsletter-cta-title">제주에서 시작되는 이야기,<br/>놓치지 않으려면.</h2>
      <p class="newsletter-cta-desc">이메일을 남겨주세요.<br/>제주랩스의 새로운 이야기가 찾아갑니다.</p>
      <form
        class="newsletter-cta-form"
        name="newsletter"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <input type="hidden" name="bot-field" />
        <input type="email" name="email" placeholder="이메일 주소를 입력하세요" required />
        <button type="submit">구독하기</button>
      </form>
    </div>
  </div>
</BaseLayout>
