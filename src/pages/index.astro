---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryNames: Record<string, string> = {
  'brand-story': 'Brand Story',
  'ingredient': 'Ingredient',
  'beauty-lab': 'Beauty Lab',
  'jeju-life': 'Jeju Life',
  'notice': 'Notice',
};

const heroPost = posts[0];
const restPosts = posts.slice(1);
---

<BaseLayout title="Home">
  <div class="main-content">

    {/* HERO POST */}
    {heroPost && (
      <article class="hero-post">
        <a href={`/blog/${heroPost.id}`}>
          {heroPost.data.thumbnail ? (
            <div class="hero-post-image">
              <img src={heroPost.data.thumbnail} alt={heroPost.data.title} />
            </div>
          ) : (
            <div class="hero-post-image-placeholder"></div>
          )}
          <div class="hero-post-overlay">
            <span class="hero-post-category">
              {categoryNames[heroPost.data.category] || heroPost.data.category}
            </span>
            <h2 class="hero-post-title">{heroPost.data.title}</h2>
            <p class="hero-post-desc">{heroPost.data.description}</p>
            <div class="hero-post-meta">
              <span class="hero-post-author">{heroPost.data.author}</span>
              <time>
                {heroPost.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\./g, '.').replace(/\s/g, ' ')}
              </time>
            </div>
          </div>
        </a>
      </article>
    )}

    {/* POST LIST - 오렌지/다크 교차 */}
    <div class="post-list">
      {restPosts.map((post, index) => {
        const isFeature = index > 0 && index % 4 === 3;
        const isOrange = index % 2 === 1;

        if (isFeature) {
          return (
            <article class="feature-post">
              <a href={`/blog/${post.id}`}>
                {post.data.thumbnail ? (
                  <div class="feature-post-image">
                    <img src={post.data.thumbnail} alt={post.data.title} />
                  </div>
                ) : (
                  <div class="feature-post-image-placeholder"></div>
                )}
                <div class="feature-post-overlay">
                  <span class="feature-post-category">
                    {categoryNames[post.data.category] || post.data.category}
                  </span>
                  <h2 class="feature-post-title">{post.data.title}</h2>
                  <p class="feature-post-desc">{post.data.description}</p>
                  <div class="feature-post-meta">
                    <span>{post.data.author}</span>
                    <time>
                      {post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\./g, '.').replace(/\s/g, ' ')}
                    </time>
                  </div>
                </div>
              </a>
            </article>
          );
        }

        return (
          <article class={`post-item ${isOrange ? 'orange' : ''}`}>
            <a href={`/blog/${post.id}`}>
              {post.data.thumbnail ? (
                <div class="post-item-image">
                  <img src={post.data.thumbnail} alt={post.data.title} />
                </div>
              ) : (
                <div class="post-item-image-placeholder"></div>
              )}
              <div class="post-item-body">
                <span class="post-item-category">
                  {categoryNames[post.data.category] || post.data.category}
                </span>
                <h2 class="post-item-title">{post.data.title}</h2>
                <p class="post-item-desc">{post.data.description}</p>
                <div class="post-item-footer">
                  <span class="post-item-author">{post.data.author}</span>
                  <time class="post-item-date">
                    {post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\./g, '.').replace(/\s/g, ' ')}
                  </time>
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>

  </div>
</BaseLayout>
