---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryNames: Record<string, string> = {
  'brand-story': 'Brand Story',
  'ingredient': 'Ingredient',
  'beauty-lab': 'Beauty Lab',
  'jeju-life': 'Jeju Life',
  'notice': 'Notice',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
}

const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft && p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const related = allPosts.slice(0, 2);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article-detail">
    <span class="article-category">
      {categoryNames[post.data.category] || post.data.category}
    </span>
    <h1 class="article-title">{post.data.title}</h1>
    <div class="article-meta">
      <span class="author">{post.data.author}</span>
      <time>{formatDate(post.data.date)}</time>
    </div>
    <div class="article-body">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <div class="related-articles">
      <h3>다른 이야기도 읽어보세요</h3>
      <div class="related-articles-grid">
        {related.map(r => (
          <a href={`/blog/${r.id}`} class="related-article-item">
            <h4>{r.data.title}</h4>
            <p>{formatDate(r.data.date)}</p>
          </a>
        ))}
      </div>
    </div>
  )}
</BaseLayout>
