---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const categoryConfig: Record<string, { name: string; description: string }> = {
  'brand-story': { name: 'Brand Story', description: '제주시트러스랩스의 여정과 철학을 이야기합니다.' },
  'ingredient': { name: 'Ingredient', description: '제주 원료의 가치를 탐구합니다.' },
  'beauty-lab': { name: 'Beauty Lab', description: '클린뷰티 트렌드와 스킨케어 인사이트를 나눕니다.' },
  'jeju-life': { name: 'Jeju Life', description: '제주의 문화, 사람, 그리고 라이프스타일.' },
  'notice': { name: 'Notice', description: '공지사항과 소식을 전합니다.' },
};

export function getStaticPaths() {
  return Object.keys(categoryConfig).map(category => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const config = categoryConfig[category] || { name: category, description: '' };

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft && post.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryNames: Record<string, string> = {
  'brand-story': 'Brand Story',
  'ingredient': 'Ingredient',
  'beauty-lab': 'Beauty Lab',
  'jeju-life': 'Jeju Life',
  'notice': 'Notice',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---

<BaseLayout title={config.name} description={config.description}>
  <div class="category-header">
    <h1>{config.name}</h1>
    <p>{config.description}</p>
  </div>

  {posts.length === 0 ? (
    <div class="category-empty">
      <p>아직 이 카테고리에 게시된 글이 없습니다.</p>
    </div>
  ) : (
    <div class="post-list">
      {posts.map((post, index) => {
        const isOrange = index % 2 === 1;
        return (
          <article class={`post-item ${isOrange ? 'orange' : ''}`}>
            <a href={`/blog/${post.id}`}>
              {post.data.thumbnail ? (
                <div class="post-item-image">
                  <img src={post.data.thumbnail} alt={post.data.title} />
                </div>
              ) : (
                <div class="post-item-image-placeholder"></div>
              )}
              <div class="post-item-body">
                <span class="post-item-category">
                  {categoryNames[post.data.category] || post.data.category}
                </span>
                <h2 class="post-item-title">{post.data.title}</h2>
                <p class="post-item-desc">{post.data.description}</p>
                <div class="post-item-footer">
                  <span class="post-item-author">{post.data.author}</span>
                  <time class="post-item-date">{formatDate(post.data.date)}</time>
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  )}
</BaseLayout>
