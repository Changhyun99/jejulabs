---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const categoryConfig: Record<string, { name: string; desc: string }> = {
  'brand-story': {
    name: 'Brand Story',
    desc: '제주시트러스랩스와 제주랩스의 여정, 비하인드, 그리고 브랜드 철학을 담은 이야기.'
  },
  'ingredient': {
    name: 'Ingredient',
    desc: '감귤박, 당근잎, 괭생이모자반까지 — 제주 원료의 본질을 탐구합니다.'
  },
  'beauty-lab': {
    name: 'Beauty Lab',
    desc: '클린뷰티 트렌드, 스킨케어 루틴, 비건 인증에 대한 깊이 있는 이야기.'
  },
  'jeju-life': {
    name: 'Jeju Life',
    desc: '제주의 계절, 로컬 크리에이터, 업사이클링 문화를 재해석합니다.'
  },
  'notice': {
    name: 'Notice',
    desc: '공지사항, 이벤트, 팝업 소식.'
  },
};

export async function getStaticPaths() {
  const categories = ['brand-story', 'ingredient', 'beauty-lab', 'jeju-life', 'notice'];
  return categories.map(category => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const config = categoryConfig[category] || { name: category, desc: '' };

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft && post.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\./g, '.').replace(/\s/g, ' ');
}
---

<BaseLayout title={config.name}>
  <div class="main-content">

    <div class="category-header">
      <h1>{config.name}</h1>
      <p>{config.desc}</p>
    </div>

    {posts.length === 0 && (
      <div style="padding:80px 48px;text-align:center;">
        <p style="color:var(--jl-text-muted);font-size:1.1rem;">아직 이 카테고리에 글이 없습니다.</p>
        <a href="/" class="btn" style="margin-top:24px;">홈으로 돌아가기</a>
      </div>
    )}

    <div class="post-list">
      {posts.map((post, index) => {
        const isOrange = index % 2 === 1;
        return (
          <article class={`post-item ${isOrange ? 'orange' : ''}`}>
            <a href={`/blog/${post.id}`}>
              {post.data.thumbnail ? (
                <div class="post-item-image">
                  <img src={post.data.thumbnail} alt={post.data.title} />
                </div>
              ) : (
                <div class="post-item-image-placeholder"></div>
              )}
              <div class="post-item-body">
                <span class="post-item-category">{config.name}</span>
                <h2 class="post-item-title">{post.data.title}</h2>
                <p class="post-item-desc">{post.data.description}</p>
                <div class="post-item-footer">
                  <span class="post-item-author">{post.data.author}</span>
                  <time class="post-item-date">{formatDate(post.data.date)}</time>
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>

  </div>
</BaseLayout>
