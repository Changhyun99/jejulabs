---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = '제주랩스 — 제주 감귤 부산물로 만든 클린 스킨케어 브랜드. 본질을 탐구하고, 그것을 재해석합니다.',
  keywords = '제주랩스, jejulabs, 제주 화장품, 제주 클린뷰티, 감귤 스킨케어, 제주 감귤, 비건 화장품, 제주 브랜드',
  ogImage = '/images/brand/og-brand.jpg',
  ogType = 'website',
} = Astro.props;

const siteUrl = 'https://jejulabs.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const pageTitle = title === 'Home' ? '제주랩스 | JEJULABS MAGAZINE' : `${title} | 제주랩스 JEJULABS`;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="robots" content="index, follow" />
  <meta name="naver-site-verification" content="785dc465cf0046bfaa176ae82282f404a4a5f417" />

  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" href="/favicon.ico" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="제주랩스 JEJULABS" />
  <meta property="og:locale" content="ko_KR" />

  <!-- JSON-LD 구조화 데이터 -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "제주랩스",
    "alternateName": "JEJULABS",
    "url": siteUrl,
    "logo": `${siteUrl}/images/jejulabs-logo.png`,
    "description": "제주 감귤 부산물로 만든 클린 스킨케어 브랜드",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "제주특별자치도",
      "addressCountry": "KR"
    },
    "sameAs": [
      "https://instagram.com/jejulabs_official",
      "https://smartstore.naver.com/jejulabs"
    ]
  })} />

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

  <!-- HEADER -->
  <header id="header">
    <div class="header-inner">
      <div class="logo">
        <a href="/">
          <img src="/images/jejulabs-logo-txt.svg" alt="제주랩스" class="logo-img" />
        </a>
      </div>
      <button class="hamburger" id="hamburger" aria-label="메뉴 열기">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <!-- GNB SLIDE PANEL -->
  <nav id="gnb" class="gnb">
    <p class="gnb-category">Magazine</p>
        <ul class="gnb-list">
      <li><a href="/">Home</a></li>
      <li><a href="/category/people">사람</a></li>
      <li><a href="/category/making">사물</a></li>
      <li><a href="/category/jeju">문화</a></li>
      <li><a href="/category/discovery">재해석</a></li>
    </ul>
    <p class="gnb-category">Brand</p>
    <ul class="gnb-list">
      <li><a href="/about">About</a></li>
      <li><a href="/editors">Editors</a></li>
      <li><a href="https://smartstore.naver.com/jejulabs" target="_blank" rel="noopener">Shop</a></li>
    </ul>
    <p class="gnb-category">Connect</p>
    <ul class="gnb-list">
      <li><a href="https://instagram.com/jejulabs_official" target="_blank" rel="noopener">Instagram</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>

  <!-- DIMMED OVERLAY -->
  <div id="dimmed" class="dimmed"></div>

  <!-- MAIN -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer id="footer">
    <div class="footer-inner">
      <div class="footer-logo">JEJULABS</div>
      <p class="footer-slogan">본질을 탐구하고, 그것을 재해석합니다.</p>
      <div class="footer-links">
        <a href="https://smartstore.naver.com/jejulabs" target="_blank" rel="noopener">Shop</a>
        <a href="https://instagram.com/jejulabs_official" target="_blank" rel="noopener">Instagram</a>
        <a href="/about">About</a>
        <a href="/editors">Editors</a>
        <a href="/contact">Contact</a>
      </div>
      <p class="footer-copy">&copy; 2026 JEJU CITRUS LABS. All rights reserved.</p>
    </div>
  </footer>

  <!-- MENU SCRIPT -->
  <script is:inline>
    const hamburger = document.getElementById('hamburger');
    const gnb = document.getElementById('gnb');
    const dimmed = document.getElementById('dimmed');

    function toggleMenu() {
      hamburger?.classList.toggle('on');
      gnb?.classList.toggle('on');
      dimmed?.classList.toggle('on');
      document.body.classList.toggle('menu-open');
    }

    function closeMenu() {
      hamburger?.classList.remove('on');
      gnb?.classList.remove('on');
      dimmed?.classList.remove('on');
      document.body.classList.remove('menu-open');
    }

    hamburger?.addEventListener('click', toggleMenu);
    dimmed?.addEventListener('click', closeMenu);

    document.querySelectorAll('.gnb-list a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Netlify Identity
    function handleIdentity() {
      if (!window.netlifyIdentity) {
        setTimeout(handleIdentity, 100);
        return;
      }

      var hash = window.location.hash || '';
      if (hash.includes('invite_token') || hash.includes('recovery_token') || hash.includes('confirmation_token')) {
        window.netlifyIdentity.open();
      }

      window.netlifyIdentity.on('init', function(user) {
        if (!user) {
          window.netlifyIdentity.on('login', function() {
            document.location.href = '/admin/';
          });
        }
      });
    }

    handleIdentity();

  </script>

</body>
</html>
