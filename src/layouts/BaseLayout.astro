---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'JEJULABS MAGAZINE – 제주의 감귤에서 시작된 클린뷰티 이야기' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | JEJULABS MAGAZINE</title>
  <link rel="icon" href="/favicon.ico" />
</head>
<body>

  <!-- HEADER -->
  <header id="header">
    <div class="header-inner">
      <div class="logo">
        <a href="/">JEJULABS</a>
        <p class="tagline">MAGAZINE BY JEJU CITRUS LABS</p>
      </div>
      <button class="hamburger" id="hamburger" aria-label="메뉴 열기">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <!-- GNB SLIDE PANEL -->
  <nav id="gnb" class="gnb">
    <p class="gnb-category">Magazine</p>
    <ul class="gnb-list">
      <li><a href="/">Home</a></li>
      <li><a href="/category/brand-story">Brand Story</a></li>
      <li><a href="/category/ingredient">Ingredient</a></li>
      <li><a href="/category/beauty-lab">Beauty Lab</a></li>
      <li><a href="/category/jeju-life">Jeju Life</a></li>
    </ul>
    <p class="gnb-category">Info</p>
    <ul class="gnb-list">
      <li><a href="/about">About</a></li>
      <li><a href="https://jejulabs.com" target="_blank" rel="noopener">Official Site</a></li>
      <li><a href="https://instagram.com/jejulabs_official" target="_blank" rel="noopener">Instagram</a></li>
    </ul>
  </nav>

  <!-- DIMMED OVERLAY -->
  <div id="dimmed" class="dimmed"></div>

  <!-- MAIN -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer id="footer">
    <div class="footer-inner">
      <div class="footer-logo">JEJULABS</div>
      <div class="footer-links">
        <a href="https://jejulabs.com" target="_blank" rel="noopener">Official</a>
        <a href="https://instagram.com/jejulabs_official" target="_blank" rel="noopener">Instagram</a>
        <a href="/about">About</a>
      </div>
      <p class="footer-copy">&copy; 2026 JEJU CITRUS LABS. All rights reserved.</p>
    </div>
  </footer>

  <!-- MENU SCRIPT -->
  <script>
    const hamburger = document.getElementById('hamburger');
    const gnb = document.getElementById('gnb');
    const dimmed = document.getElementById('dimmed');

    function toggleMenu() {
      hamburger?.classList.toggle('on');
      gnb?.classList.toggle('on');
      dimmed?.classList.toggle('on');
      document.body.classList.toggle('menu-open');
    }

    function closeMenu() {
      hamburger?.classList.remove('on');
      gnb?.classList.remove('on');
      dimmed?.classList.remove('on');
      document.body.classList.remove('menu-open');
    }

    hamburger?.addEventListener('click', toggleMenu);
    dimmed?.addEventListener('click', closeMenu);

    document.querySelectorAll('.gnb-list a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  </script>

</body>
</html>
