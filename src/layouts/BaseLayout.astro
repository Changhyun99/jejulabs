---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'JEJULABS MAGAZINE — 본질을 탐구하고, 그것을 재해석합니다' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | JEJULABS MAGAZINE</title>
  <link rel="icon" href="/favicon.ico" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

  <!-- HEADER -->
  <header id="header">
    <div class="header-inner">
      <div class="logo">
        <a href="/">
          <img src="/images/jejulabs-logo-txt.svg" alt="제주랩스" class="logo-img" />
        </a>
      </div>
      <button class="hamburger" id="hamburger" aria-label="메뉴 열기">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <!-- GNB SLIDE PANEL -->
  <nav id="gnb" class="gnb">
    <p class="gnb-category">Magazine</p>
    <ul class="gnb-list">
      <li><a href="/">Home</a></li>
      <li><a href="/category/people">People</a></li>
      <li><a href="/category/discovery">Discovery</a></li>
      <li><a href="/category/making">Making</a></li>
      <li><a href="/category/jeju">Jeju</a></li>
    </ul>
    <p class="gnb-category">Brand</p>
    <ul class="gnb-list">
      <li><a href="/about">About</a></li>
      <li><a href="https://smartstore.naver.com/jejulabs" target="_blank" rel="noopener">Shop</a></li>
    </ul>
    <p class="gnb-category">Connect</p>
    <ul class="gnb-list">
      <li><a href="https://instagram.com/jejulabs_official" target="_blank" rel="noopener">Instagram</a></li>
      <li><a href="mailto:contact@jejulabs.com" class="copy-email-link">Contact</a></li>
    </ul>
  </nav>

  <!-- DIMMED OVERLAY -->
  <div id="dimmed" class="dimmed"></div>

  <!-- MAIN -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer id="footer">
    <div class="footer-inner">
      <div class="footer-logo">JEJULABS</div>
      <p class="footer-slogan">본질을 탐구하고, 그것을 재해석합니다.</p>
      <div class="footer-links">
        <a href="https://smartstore.naver.com/jejulabs" target="_blank" rel="noopener">Shop</a>
        <a href="https://instagram.com/jejulabs_official" target="_blank" rel="noopener">Instagram</a>
        <a href="/about">About</a>
        <a href="mailto:contact@jejulabs.com" class="copy-email-link">Contact</a>
      </div>
      <p class="footer-copy">&copy; 2026 JEJU CITRUS LABS. All rights reserved.</p>
    </div>
  </footer>

  <!-- MENU SCRIPT -->
  <script is:inline>
    const hamburger = document.getElementById('hamburger');
    const gnb = document.getElementById('gnb');
    const dimmed = document.getElementById('dimmed');

    function toggleMenu() {
      hamburger?.classList.toggle('on');
      gnb?.classList.toggle('on');
      dimmed?.classList.toggle('on');
      document.body.classList.toggle('menu-open');
    }

    function closeMenu() {
      hamburger?.classList.remove('on');
      gnb?.classList.remove('on');
      dimmed?.classList.remove('on');
      document.body.classList.remove('menu-open');
    }

    hamburger?.addEventListener('click', toggleMenu);
    dimmed?.addEventListener('click', closeMenu);

    document.querySelectorAll('.gnb-list a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Netlify Identity
    function handleIdentity() {
      if (!window.netlifyIdentity) {
        setTimeout(handleIdentity, 100);
        return;
      }

      var hash = window.location.hash || '';
      if (hash.includes('invite_token') || hash.includes('recovery_token') || hash.includes('confirmation_token')) {
        window.netlifyIdentity.open();
      }

      window.netlifyIdentity.on('init', function(user) {
        if (!user) {
          window.netlifyIdentity.on('login', function() {
            document.location.href = '/admin/';
          });
        }
      });
    }

    handleIdentity();

    // Copy email to clipboard
    document.querySelectorAll('.copy-email-link').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.preventDefault();
        navigator.clipboard.writeText('contact@jejulabs.com').then(function() {
          var original = el.textContent;
          el.textContent = '복사됨!';
          setTimeout(function() { el.textContent = original; }, 2000);
        });
      });
    });
  </script>

</body>
</html>
